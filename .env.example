# Environment Configuration for SIH-26154 Semantic Document Processing System

PROJECT_NAME="SIH-26154 Semantic Document Processing System"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="sih_content_platform"

# Full URL Override (Optional)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/sih_content_platform"

# Analyzer Engine: 'pp_structure' or 'fallback'
DOC_ANALYZER_ENGINE="pp_structure"
ENABLE_OCR=true
MAX_UPLOAD_SIZE_MB=50

# CORS
BACKEND_CORS_ORIGINS=["*"]
