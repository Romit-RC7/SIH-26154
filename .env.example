# Environment Configuration for SIH-26154 Semantic Document Processing System

PROJECT_NAME="SIH-26154 Semantic Document Processing System"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database Settings (PostgreSQL + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="sih_content_platform"

# Full Database URL Override (Optional)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sih_content_platform"

# Layout Engine & OCR Configuration
# Options: 'pp_structure' (production PaddleOCR) or 'rule_based' (fast PyMuPDF fallback)
DOC_ANALYZER_ENGINE="pp_structure"
ENABLE_OCR=true
MAX_UPLOAD_SIZE_MB=50

# GPU & Hardware Acceleration
USE_GPU=true
N_GPU_LAYERS=-1  # -1 offloads 100% of LLM/VLM layers to GPU in llama-cpp-python

# Recognition Batching Pipeline
RECOGNITION_BATCH_SIZE=4
RECOGNITION_BATCH_WAIT_SECONDS=0.5

# Offline LLM & Ollama Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:latest"
QWEN_VISION_N_CTX=4096

# CORS
BACKEND_CORS_ORIGINS=["*"]
